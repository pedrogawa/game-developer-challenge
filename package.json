{
  "name": "pirate-battle-gameplay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test visual.spec.ts --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "test:performance": "npm run build && playwright test -c playwright.performance.config.ts",
    "test:performance:report": "playwright show-report performance/playwright-report",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint ."
  },
  "dependencies": {
    "@pixi/tilemap": "^5.0.2",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "msw": "^3.0.0",
    "pixi.js": "^8.13.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "assets"
    ]
  }
}
